{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Step 1: Generate Company Overview",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/data_scripts/step_1_generate_company_overview.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Step 2: Generate Initiatives",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/data_scripts/step_2_generate_initiatives.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
